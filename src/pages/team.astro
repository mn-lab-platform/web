---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import { UniversitySchema } from '../content.config';
import type { University } from '../content.config';

const teamMembers = await getCollection('team');
teamMembers.sort((a, b) => (a.data.sort) - (b.data.sort));

function getUniversityDetails(uni: University) {
  switch (uni) {
    case UniversitySchema.enum.JU:
      return { label: 'JU', badgeClass: 'bg-[#003876] text-white' };
    case UniversitySchema.enum.WUT:
      return { label: 'WUT', badgeClass: 'bg-[#1E293B] text-white' };
    case UniversitySchema.enum.WUST:
      return { label: 'WUST', badgeClass: 'bg-[#7A1315] text-white' };
    default:
      return { label: uni, badgeClass: 'bg-slate-700 text-white' };
  }
}
---

<BaseLayout title="Meet the Team" description="The people behind Mare Nostrum LAB Platform">
    <CardGrid title="Meet the Team" gridCols="grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {teamMembers.map((member: CollectionEntry<'team'>) => (
            <article class="h-full w-full max-w-md flex flex-col mx-auto p-4 border border-slate-200 rounded-xl shadow-xs">
                <header class="grid min-h-28 min-w-0 grid-cols-[7rem_minmax(0,1fr)] items-center gap-4">
                    {member.data.avatar ? (
                        <Image src={member.data.avatar} alt={member.data.name} width={112} height={112} class="size-28 rounded-full object-cover" loading="eager"/>
                    ) : (
                        <svg class="size-28 rounded-full p-3 text-primary/20" aria-hidden="true" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M7.5.875a3.625 3.625 0 0 0-1.006 7.109c-1.194.145-2.218.567-2.99 1.328-.982.967-1.479 2.408-1.479 4.288a.475.475 0 1 0 .95 0c0-1.72.453-2.88 1.196-3.612.744-.733 1.856-1.113 3.329-1.113s2.585.38 3.33 1.113c.742.733 1.195 1.892 1.195 3.612a.475.475 0 1 0 .95 0c0-1.88-.497-3.32-1.48-4.288-.77-.76-1.795-1.183-2.989-1.328A3.627 3.627 0 0 0 7.5.875M4.825 4.5a2.675 2.675 0 1 1 5.35 0 2.675 2.675 0 0 1-5.35 0" fill="currentColor"/>
                        </svg>
                    )}
                    <div class="min-w-0 flex-1">
                        <h3 class="text-xl font-semibold">{member.data.name}</h3>  
                        <p class="text-primary text-sm">{member.data.role}</p>
                        <div class="flex items-center gap-2 text-text-muted">
                            {member.data.universityProfile && (
                                <a href={member.data.universityProfile} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} university profile`} class="transition-colors hover:text-primary">
                                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M16 6.28a1.23 1.23 0 0 0-.62-1.07l-6.74-4a1.27 1.27 0 0 0-1.28 0l-6.75 4a1.25 1.25 0 0 0 0 2.15l1.92 1.12v2.81a1.28 1.28 0 0 0 .62 1.09l4.25 2.45a1.28 1.28 0 0 0 1.24 0l4.25-2.45a1.28 1.28 0 0 0 .62-1.09V8.45l1.24-.73v2.72H16zm-3.73 5L8 13.74l-4.22-2.45V9.22l3.58 2.13a1.29 1.29 0 0 0 1.28 0l3.62-2.16zM8 10.27l-6.75-4L8 2.26l6.75 4z"/>
                                    </svg>
                                </a>
                            )}
                            {member.data.publications && (
                                <a href={member.data.publications} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} publications`} class="transition-colors hover:text-primary">
                                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M14.5 2H9l-.35.15-.65.64-.65-.64L7 2H1.5l-.5.5v10l.5.5h5.29l.86.85h.7l.86-.85h5.29l.5-.5v-10zm-7 10.32-.18-.17L7 12H2V3h4.79l.74.74zM14 12H9l-.35.15-.14.13V3.7l.7-.7H14zM6 5H3v1h3zm0 4H3v1h3zM3 7h3v1H3zm10-2h-3v1h3zm-3 2h3v1h-3zm0 2h3v1h-3z"/>
                                    </svg>
                                </a>
                            )}
                            {member.data.github && (
                                <a href={member.data.github} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} on GitHub`} class="transition-colors hover:text-primary">
                                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
                                    </svg>
                                </a>
                            )}
                            {member.data.linkedin && (
                                <a href={member.data.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.data.name} on LinkedIn`} class="transition-colors hover:text-primary">
                                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M20.47 2H3.53a1.45 1.45 0 0 0-1.47 1.43v17.14A1.45 1.45 0 0 0 3.53 22h16.94a1.45 1.45 0 0 0 1.47-1.43V3.43A1.45 1.45 0 0 0 20.47 2M8.09 18.74h-3v-9h3ZM6.59 8.48a1.56 1.56 0 1 1 0-3.12 1.57 1.57 0 1 1 0 3.12m12.32 10.26h-3v-4.83c0-1.21-.43-2-1.52-2A1.65 1.65 0 0 0 12.85 13a2 2 0 0 0-.1.73v5h-3v-9h3V11a3 3 0 0 1 2.71-1.5c2 0 3.45 1.29 3.45 4.06Z"/>
                                    </svg>
                                </a>
                            )}
                            {member.data.email && (
                                <a href={`mailto:${member.data.email}`} aria-label={`Email ${member.data.name}`} class="transition-colors hover:text-primary">
                                    <svg class="size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm3.519 0L12 11.671 18.481 6zM20 7.329l-7.341 6.424a1 1 0 0 1-1.318 0L4 7.329V18h16z"/>
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                </header>
                <p class="my-4 text-sm text-text-muted leading-relaxed">
                    {member.data.description}
                </p>
                <div class="mt-auto flex flex-col w-full">
                    <ul class="flex flex-wrap gap-2">
                        {member.data.university.map((university) => {
                            const { label, badgeClass } = getUniversityDetails(university);
                            return(
                                <li class={`border border-transparent text-xs font-semibold px-3 py-1 rounded-full shadow-sm ${badgeClass}`}>
                                    {label}
                                </li>
                            );
                        })}
                        {member.data.expertise.map((skill: string) => (
                            <li class="text-primary border border-blue-200 text-xs font-semibold px-3 py-1 rounded-full shadow-sm">
                                {skill}
                            </li>
                        ))}
                    </ul>
                </div>
            </article>
        ))}
    </CardGrid>
</BaseLayout>