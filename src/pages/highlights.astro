---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import HighlightArticle from "../components/HighlightArticle.astro";

import highlightImage1 from "../assets/highlights/highlight-1.png";
import highlightImage2 from "../assets/highlights/highlight-2.png";
import highlightImage3 from "../assets/highlights/highlight-3.png";
import highlightImage4 from "../assets/highlights/highlight-4.png";
import highlightImage5 from "../assets/highlights/highlight-5.png";
import highlightImage6 from "../assets/highlights/highlight-6.png";
---

<BaseLayout title="Project Highlights" description="Discover the most important features we've built along the way.">
    <CardGrid title="Platform Highlights" gridCols="grid-cols-1 md:grid-cols-2">
        <HighlightArticle image={highlightImage1} title="Arches for Excavation" 
            description="As our flagship deployment, Arches for Excavation is designed to be the digital foundation of your project, 
                ready to be set up the moment you break ground at a new site. Built upon the powerful [Arches Project](https://archesproject.org) framework, it acts as a comprehensive, all-in-one environment tailored specifically for the realities 
                of archaeological fieldwork. We built this core system to serve as a central hub pre-configured with specialized data models, integrated mapping, and intuitive upload workflows ensuring that complex field 
                data entry is as seamless and effortless as possible from day one." 
        />
        <HighlightArticle image={highlightImage2} title="Feature 2" description="Description for Feature 2" />
        <HighlightArticle image={highlightImage3} title="Feature 3" description="Description for Feature 3" />
        <HighlightArticle image={highlightImage4} title="Feature 4" description="Description for Feature 4" />
        <HighlightArticle image={highlightImage5} title="Feature 5" description="Description for Feature 5" />
        <HighlightArticle image={highlightImage6} title="Feature 6" description="Description for Feature 6" />
    </CardGrid>
</BaseLayout>