---
import archesLandingImage from '../../assets/page-arches-img/arches-landing.png';
import archesModelsImage from '../../assets/page-arches-img/arches-models.png';
import archesWorkflowsImage from '../../assets/page-arches-img/arches-workflows.png';
import archesMapImage from '../../assets/page-arches-img/arches-map.png';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolContent from '../../components/ToolContent.astro';
import TextImageRow from '../../components/TextImageRow.astro';
---

<BaseLayout title="Arches for JU Excavations" 
    description="Arches for JU Excavations is a custom open-source platform tailored for archaeological fieldwork, featuring CIDOC CRM data models, GIS mapping, and intuitive workflows.">
    
    <ToolContent title="Arches for JU Excavations" repoUrl="https://github.com/mn-lab-platform/arches-for-ju-excavations">
            <TextImageRow 
                textTitle="A Digital Foundation for Fieldwork" 
                text="Arches for JU Excavations is designed to be the digital foundation of your project, ready to be set up the moment you break ground at a new site. Built upon the powerful [Arches Project](https://archesproject.org) framework, it acts as a comprehensive, all-in-one environment tailored specifically for the realities of archaeological fieldwork. The system comes with its own pre-configured, specialized data models, integrated mapping, and intuitive upload workflows—ensuring that complex field data entry is as seamless and effortless as possible from day one."
                imageSrc={archesLandingImage}
                loadingMode="eager"
            />
            
            <TextImageRow 
                textTitle="Ontology-Driven Data Models" 
                text="To guarantee semantic richness and global standardization, we developed a custom archaeological data model strictly adhering to the [CIDOC CRM (v7.1)](https://cidoc-crm.org/Version/version-7.1) ontology. The system is populated with tailored resource models reflecting real-world archeological entities such as Trenches or Contexts, allowing researchers to accurately map physical excavations to digital archives."
                imageSrc={archesModelsImage}
                textFirst={false}
                loadingMode="eager"
            />

            <TextImageRow 
                textTitle="Intuitive Data Entry Workflows" 
                text="Archaeological data entry shouldn't require a computer science degree. We designed a custom set of guided, step-by-step workflows to streamline the upload process. Whether you are logging a new pottery shard, importing total station data, or uploading a 3D model, these simplified forms ensure that complex data is captured consistently and effortlessly directly in the field."
                imageSrc={archesWorkflowsImage}
            />

            <TextImageRow 
                textTitle="Integrated Spatial Mapping" 
                text="Advanced geospatial analysis is built directly into Arches for JU Excavations. Our custom map plugin allows archaeologists to visualize and customize the appearance of resources overlaid on top of self-uploaded, high-resolution basemaps, such as aerial drone imagery. You can interact with and visualize spatial data without ever needing to switch to a separate GIS application."
                imageSrc={archesMapImage}
                textFirst={false}
            />
    </ToolContent>
</BaseLayout>