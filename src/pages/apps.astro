---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';

const services = await getCollection('services');
services.sort((a, b) => (a.data.sort) - (b.data.sort));
---

<BaseLayout title="Our Live Apps" description="Our live apps at Mare Nostrum LAB Platform" >
    <CardGrid title="Our Live Apps">
        {services.map((service: CollectionEntry<'services'>) => (
            <article class="h-full w-full max-w-xl mx-auto flex flex-col items-start text-start bg-white border border-slate-200 rounded-xl shadow-xs transition-colors duration-200 hover:border-slate-300">
                <div class="w-full h-32 flex items-center justify-center py-3 px-8 bg-primary/10 rounded-t-xl border-b border-slate-100">
                    <Image src={service.data.icon} alt={service.data.name} class="max-h-full max-w-full object-contain" loading="eager"/>
                </div>
                <div class="flex flex-col gap-4 p-6 flex-1">
                    <h3 class="text-xl font-semibold text-text-primary">
                        {service.data.name}
                    </h3>
                    <p class="text-sm text-text-muted leading-relaxed [&_a]:text-primary [&_a]:underline [&_a]:transition-colors" 
                        set:html={marked.parseInline(service.data.description)} 
                    >  
                    </p>
                </div>
                <a 
                    href={service.data.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="group w-full mt-auto border-t border-slate-200 text-sm font-semibold text-text-muted flex justify-between items-center px-6 py-4 transition-colors duration-200 hover:text-primary hover:bg-slate-50 rounded-b-xl"
                >
                    Visit Application
                    <svg aria-hidden="true" fill="currentColor" class="w-4 h-4 text-slate-400 transition-all duration-200 ease-out group-hover:translate-x-1 group-hover:text-primary" viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"/>
                    </svg>
                </a>
            </article>
            )
        )}
    </CardGrid>
</BaseLayout>