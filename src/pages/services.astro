---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';

const services = await getCollection('services');
services.sort((a, b) => (a.data.sort) - (b.data.sort));
---

<BaseLayout title="Our Services" description="Our services at Mare Nostrum Platform" >
    <CardGrid title="Our Services">
        {services.map((service: CollectionEntry<'services'>) => (
            <article class="w-full max-w-xs mx-auto flex flex-col items-start gap-2 text-start transition-transform hover:-translate-y-1">
                <div class="w-full h-32 flex items-center justify-center p-2 bg-primary/10 rounded-3xl">
                    <Image src={service.data.icon} alt={service.data.name} class="max-h-full max-w-full object-contain" loading="eager"/>
                </div>
                <div class="px-3 py-2">
                    <a href={service.data.url} target="_blank" class="hover:text-primary-hover transition-colors">
                        <h3 class="text-xl font-semibold">
                            {service.data.name}<span class="whitespace-nowrap">&nbsp;<svg aria-hidden="true" class="inline-block align-text-top" width="1em" height="1em" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4m-8-2 8-8m0 0v5m0-5h-5"/></svg></span>
                        </h3>
                    </a>
                    <span 
                        class="text-sm text-text-muted text-balance [&_a]:text-primary [&_a]:underline hover:[&_a]:text-primary-hover [&_a]:transition-colors" 
                        set:html={marked.parseInline(service.data.description)} 
                    />
                </div>
            </article>
            )
        )}
    </CardGrid>
</BaseLayout>