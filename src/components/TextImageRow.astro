---
import type { ImageMetadata } from 'astro';
import { Picture } from "astro:assets";
import { marked } from 'marked';
import PageSubheading from './PageSubheading.astro';

interface Props {
    textTitle: string;
    text: string;
    imageSrc: ImageMetadata;
    textFirst?: boolean;
    loadingMode?: 'lazy' | 'eager';
}

const { text, imageSrc, textFirst = true, textTitle, loadingMode = 'lazy' } = Astro.props;
---

<div class={`w-full grid grid-cols-1 gap-8 ${textFirst ? 'lg:grid-cols-[4fr_6fr]' : 'lg:grid-cols-[6fr_4fr]'}`}>
    
    <div class={`flex flex-col justify-center max-w-lg ${textFirst ? 'lg:order-1 lg:ml-auto' : 'lg:order-2 lg:mr-auto'}`}>
        <PageSubheading text={textTitle} />
        <p 
            class="text-text-muted [&_a]:text-primary [&_a]:underline hover:[&_a]:text-primary [&_a]:transition-colors" 
            set:html={marked.parseInline(text)} 
        />
    </div>

    <div class={`w-full flex items-center ${textFirst ? 'lg:order-2' : 'lg:order-1'}`}>
        <Picture class="w-full h-auto rounded-xl shadow-md" src={imageSrc} alt={textTitle} loading={loadingMode} />
    </div>

</div>