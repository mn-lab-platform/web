---
import PageHeading from '../components/PageHeading.astro';
import GithubCard from '../components/GithubCard.astro';

interface Props {
    title: string;
    repoUrl: string;
}

const { title, repoUrl } = Astro.props;
---

<section class="w-full max-w-screen-2xl mx-auto px-10 py-6">
    <PageHeading title={title} />

    <div class="flex flex-col gap-25 mt-12">
        
        <slot />

        <GithubCard repoUrl={repoUrl}/>

    </div>
</section>