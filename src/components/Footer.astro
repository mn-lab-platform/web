---
import ujIcon from "../assets/uj_icon.png";
import { Image } from "astro:assets";
---

<footer class="bg-primary py-10 mt-12 text-text-light">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 place-items-center gap-8 text-sm text-text-main md:grid-cols-2 md:place-items-start">
        <div>
            <p class="text-lg text-center font-bold">Our Contact Information</p>
            <address class="text-center">
                Mare Nostrum Lab<br />
                Faculty of Archeology, Jagiellonian University<br />
                ul. Gołębia 11, 31-007 Kraków, Poland<br />
            </address>
        </div>
        <!-- <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform duration-300">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg> -->
        <Image src={ujIcon} alt="UJ Logo" width="254"/>
    </div>
    <div class="max-w-7xl mx-auto mt-8 pt-4 border-t border-text-light/10 text-xs text-text-light/50 w-full flex flex-col md:flex-row justify-between md:space-y-0 px-4">
        <div class="text-center md:text-left">
            &copy; Mare Nostrum Lab 2026
        </div>
    </div>
</footer>