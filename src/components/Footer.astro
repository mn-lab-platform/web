---
import ujLogo from "../assets/logotypes/uj-logo.png";
import marenostrumLogo from "../assets/logotypes/marenostrum-white-logo.png";
import { Image } from "astro:assets";
---

<footer class="bg-primary py-8 mt-12 text-text-light">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 gap-8 text-sm text-text-main md:grid-cols-2">
        <div>
            <h2 class="text-lg text-center font-bold md:text-left">Find Us:</h2>
            <address class="mt-2 text-center md:text-left">
                Mare Nostrum Lab<br />
                Institute of Archeology, Jagiellonian University<br />
                ul. Gołębia 11, 31-007 Kraków, Poland<br />
            </address>
        </div>
        <div class="flex flex-col justify-center items-center gap-6 md:flex-row md:items-center md:justify-end">
            <a href="https://www.uj.edu.pl/" target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-80 md:order-2">
                <Image src={ujLogo} alt="Jagiellonian University Official Website" width="254"/>
            </a>
            
            <a href="https://mare.id.uj.edu.pl/" target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-80">
                <Image src={marenostrumLogo} alt="Mare Nostrum Lab Homepage" width="128"/>
            </a>
        </div>
    </div>
    <div class="max-w-7xl mx-auto mt-8 pt-4 border-t border-text-light/10 text-xs text-text-light/50 w-full flex flex-col md:flex-row md:justify-center ">
        <div class="text-center md:text-left">
            &copy; Mare Nostrum Lab 2026
        </div>
    </div>
</footer>