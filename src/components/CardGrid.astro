---
import PageHeading from './PageHeading.astro';

interface Props {
  title?: string;
  gridCols?: string;
  maxWidth?: string;
}

const { 
  title, 
  gridCols = "grid-cols-1 md:grid-cols-2",
  maxWidth = "max-w-screen-2xl"
} = Astro.props;
---

<section class={`flex flex-col items-center py-6 px-10 ${maxWidth} mx-auto w-full`}>
  {title && <PageHeading title={title} />}
  
  <div class={`grid gap-8 w-full justify-items-center ${gridCols}`}>
    <slot />
  </div>
</section>