---
interface Props {
  title?: string;
  gridCols?: string;
}

const { 
  title, 
  gridCols = "grid-cols-1 sm:grid-cols-2 md:grid-cols-3" 
} = Astro.props;
---

<section class="flex flex-col items-center p-6 max-w-screen-2xl mx-auto w-full">
  {title && <h2 class="text-4xl md:text-5xl mb-16 text-center">{title}</h2>}
  
  <div class={`grid gap-12 w-full justify-items-center ${gridCols}`}>
    <slot />
  </div>
</section>