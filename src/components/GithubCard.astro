---
import PageSubheading from '../components/PageSubheading.astro';

interface Props {
    repoUrl: string;
}

const { repoUrl } = Astro.props;
---

<div class="mt-25 text-center">
    <PageSubheading text="Source Code & Deployment" />
    <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="max-w-2xl mx-auto mt-12 flex flex-col items-center justify-center p-10 rounded-3xl bg-primary/5 hover:bg-primary/10 transition-colors border border-transparent hover:border-primary/20 text-center group">
        
        <svg class="w-10 h-10 mb-5 text-text-muted group-hover:text-primary transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"></path>
        </svg>

        <h3 class="text-2xl font-semibold mb-3 group-hover:text-primary transition-colors text-text-muted">
            View on GitHub
        </h3>
        <p class="text-text-muted text-balance leading-relaxed">
            Explore the source code, track our progress, or learn how to deploy this custom tool for your own project.
        </p>
    </a>
</div>