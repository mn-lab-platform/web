---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import mareNostrumBlueLogo from '../assets/logotypes/marenostrum-blue-logo.png';
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const siteURL = Astro.site ?? Astro.url;

const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(mareNostrumBlueLogo.src, siteURL);

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="google-site-verification" content="0Q0g-2RqfeaXSMGEJRjWjkVAnpXMdVkUo76rzTwAZ2w" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#009ACA" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Mare Nostrum Logo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    
</head>
<body class="flex flex-col min-h-screen bg-surface-primary text-text-primary font-sans antialiased tracking-wide">
    <Header />
    <main class="grow px-2 py-6">
        <slot />
    </main>
    <Footer />
</body>
</html>